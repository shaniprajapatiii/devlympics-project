# SynapseFlow Environment Configuration
# Add your Google Gemini API key below to enable real-time dynamic intent expansion and contextual card distillation
GEMINI_API_KEY=

# Optional: Default tone (professional | direct | casual)
NEXT_PUBLIC_DEFAULT_TONE=professional

# Optional: Outbound TTS speech rate (0.8 - 1.2)
NEXT_PUBLIC_TTS_RATE=1.0

# Optional: Google OAuth 2.0 Web Client ID for 1-click Google Sign-In
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

